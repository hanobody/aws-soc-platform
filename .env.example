# ==============================
# AWS SOC Platform local config
# ==============================

# PostgreSQL
DATABASE_URL=postgresql://soc_admin:soc_dev_password@localhost:5433/soc_platform
PGHOST=localhost
PGPORT=5433
PGDATABASE=soc_platform
PGUSER=soc_admin
PGPASSWORD=soc_dev_password

# Web / API
NODE_ENV=development
APP_PORT=3000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# AWS / SQS / Athena
AWS_REGION=ap-southeast-1
S3_OBJECT_CREATED_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/809893975949/cloudtrail-object-created-queue
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ATHENA_DATABASE=
ATHENA_WORKGROUP=
ATHENA_OUTPUT_LOCATION=s3://central-cloudtrail-igcock/socresults/

# Worker names
INGEST_S3_EVENT_WORKER_NAME=ingest-worker-s3-event

# S3 event ingest worker
S3_EVENT_SQS_MAX_MESSAGES=10
S3_EVENT_SQS_WAIT_SECONDS=20
S3_EVENT_SQS_VISIBILITY_TIMEOUT=300

# Telegram routing placeholders
TELEGRAM_BOT_TOKEN=
DEFAULT_TELEGRAM_CHAT_ID=
