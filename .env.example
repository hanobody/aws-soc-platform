# ==============================
# AWS SOC Platform local config
# ==============================

# PostgreSQL
DATABASE_URL=postgresql://soc_admin:soc_dev_password@localhost:5433/soc_platform
PGHOST=localhost
PGPORT=5433
PGDATABASE=soc_platform
PGUSER=soc_admin
PGPASSWORD=soc_dev_password

# Web / API
NODE_ENV=development
APP_PORT=3000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# AWS / SQS / Athena
AWS_REGION=ap-southeast-1
SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/809893975949/soc-cloudtrail-events
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ATHENA_DATABASE=
ATHENA_WORKGROUP=
ATHENA_OUTPUT_LOCATION=s3://central-cloudtrail-igcock/socresults/

# Worker names
INGEST_WORKER_NAME=ingest-worker
MATCHER_WORKER_NAME=matcher-worker

# Ingest worker
SQS_MAX_MESSAGES=10
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_TIMEOUT=120

# Matcher worker
MATCHER_BATCH_SIZE=100
MATCHER_POLL_INTERVAL_MS=3000
MATCHER_RULE_CACHE_TTL_SECONDS=15
MATCHER_MAX_ATTEMPTS=10
MATCHER_DEFAULT_SEVERITY=medium

# Telegram routing placeholders
TELEGRAM_BOT_TOKEN=
DEFAULT_TELEGRAM_CHAT_ID=
